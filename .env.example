# Copy to .env and fill in. docker compose reads it automatically.
# Never commit .env — it holds the secrets.

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Port the app is published on (nginx inside the web container).
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080

# true in production (HTTPS). Set false ONLY to test over plain http://localhost.
COOKIE_SECURE=true

# Public address of the app (used in password-reset emails).
APP_URL=http://localhost:8080

# Closed beta: people need this code to sign up. Leave empty for open sign-up.
SIGNUP_INVITE_CODE=

# Email for password-reset links, e.g. smtps://USER:PASS@smtp-relay.brevo.com:465
# Leave empty to have the link written to the api log (docker compose logs api).
SMTP_URL=
MAIL_FROM=gym-app <no-reply@your-domain>

# Accounts that can read testers' feedback (Account page).
ADMIN_EMAILS=

# Largest set video in MB (100 while sharing through a free Cloudflare tunnel).
MAX_VIDEO_MB=500

# 1 = only nginx in front of the api; 2 = Cloudflare tunnel + nginx.
TRUST_PROXY_HOPS=1
