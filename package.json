{
  "name": "gym-app",
  "version": "0.1.0",
  "private": true,
  "description": "Powerlifting & bodybuilding coaching platform: coaches build programs for their clients and track what they actually do.",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present",
    "install:all": "npm install"
  }
}
